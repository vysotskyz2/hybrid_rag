APP_NAME=DocsLens
ENVIRONMENT=local
LOG_LEVEL=INFO

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=fastapi_docs

DOCS_REPO=fastapi/fastapi
DOCS_REF=68cc4cbb2e0600841b0d6bdd1cc29038b54a00e6
DOCS_BASE_URL=https://fastapi.tiangolo.com
DOCS_SOURCE_PATH=docs/en/docs
DOCS_LANGUAGE=en
DATA_DIR=data
CHUNK_TARGET_TOKENS=280
CHUNK_MAX_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

SPARSE_MODEL=Qdrant/bm25
SPARSE_LANGUAGE=english

RETRIEVAL_CANDIDATES=30
RETRIEVAL_TOP_K=5
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3

LLM_MODE=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat
