APP_NAME=DocsLens
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=json

DATA_DIR=data
INGESTION_CONFIG=config/ingestion.toml
DOCS_ARCHIVE_URL_TEMPLATE=https://github.com/{repo}/archive/{ref}.tar.gz
DOWNLOAD_TIMEOUT=120

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=fastapi_docs
QDRANT_TIMEOUT=30
QDRANT_DISTANCE=cosine
DENSE_VECTOR_NAME=dense
SPARSE_VECTOR_NAME=sparse
PAYLOAD_INDEX_FIELDS=["section","content_type","language","version","path","project"]
INDEX_BATCH_SIZE=32

QDRANT_IMAGE=qdrant/qdrant:v1.19.2
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
API_PORT=8000
PYTHON_VERSION=3.12
UV_VERSION=0.13.4

EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
DENSE_QUERY_PREFIX="query: "
DENSE_PASSAGE_PREFIX="passage: "
NORMALIZE_EMBEDDINGS=true

SPARSE_MODEL=Qdrant/bm25
SPARSE_LANGUAGE=english

RETRIEVAL_CANDIDATES=30
RETRIEVAL_TOP_K=5
RETRIEVAL_DEFAULT_MODE=hybrid
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3

LLM_MODE=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat
